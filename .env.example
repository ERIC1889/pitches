# ==========================================
# Pitches.ai - 환경 변수 예시
# 이 파일을 .env로 복사 후 실제 값 입력
# ==========================================

# --- Database ---
DATABASE_URL="postgresql://pitches:pitches_dev@localhost:5432/pitches"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_SECRET="dev-secret-change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- OpenAI (유일한 유료 항목) ---
OPENAI_API_KEY="sk-..."
OPENAI_STT_MODEL="whisper-1"
OPENAI_REPORT_MODEL="gpt-5-nano"
# 발표 중 5초마다 부분 STT 호출 (off면 음량만 판정, 비용 0)
REALTIME_STT="on"

# --- 감정 분석 (apps/emotion, 로컬 무료) ---
# yarn emotion:dev 로 띄운 서비스 주소. 비우면 감정 분석 없이 동작
EMOTION_URL="http://127.0.0.1:8001"

# --- Apple Sign In (dev 단계에선 선택) ---
APPLE_TEAM_ID=""
APPLE_CLIENT_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# --- API Server ---
API_PORT=3000
API_HOST=0.0.0.0
API_URL=http://localhost:3000

# --- Storage ---
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# --- Node ---
NODE_ENV=development
